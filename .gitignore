# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
*.env*
*.env*.local
*.env*.production
!.env.example

# typescript
*.tsbuildinfo

# examples (scratch files in apps/mobile — do NOT blanket-ignore *.html,
# it swallows apps/dashboard/index.html, the Vite entry point)
apps/mobile/demo*.html
apps/mobile/header.html
app-example

# turborepo
.turbo

# xlsx
*.xlsx
# ...except the AGS export template. The Excel exporter patches a copy of it, so it is a
# runtime input like the report's fonts in apps/dashboard/public/report, not a scratch
# spreadsheet. Without this the file is invisible to git and the feature cannot be built
# by anyone else.
!apps/dashboard/public/ags/template.xlsx

# images
*.png
*.jpeg
# ...except the dashboard's own assets. These four were tracked before *.png was added, so
# the rule never applied to them -- until the rename, at which point the new paths were fresh
# and ignored, and `git add -A` staged the old ones as plain deletions.
# Nothing errors: the login page loses its hero and the report loses its logo at build time.
!apps/dashboard/public/favicon.png
!apps/dashboard/public/report/mmsb-logo.png
!apps/dashboard/src/assets/hero.png
!apps/dashboard/src/assets/mmsb-logo-transparent.png
# The mobile app's icon, splash and report logo. EAS leaves ignored files out of the
# upload even when git tracks them, so without this line prebuild fails on icon.png.
!apps/mobile/assets/images/*.png
