# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
*.env*
*.env*.local
*.env*.production

# typescript
*.tsbuildinfo

# examples (scratch files in apps/mobile — do NOT blanket-ignore *.html,
# it swallows apps/web/index.html, the Vite entry point)
apps/mobile/demo*.html
apps/mobile/header.html
app-example

# turborepo
.turbo

# xlsx
*.xlsx