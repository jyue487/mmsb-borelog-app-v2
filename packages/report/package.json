{
  "name": "@mmsb/report",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "spike": "node spike/runNode.ts",
    "pagination": "node --import ./scripts/register.mjs scripts/dumpPagination.ts",
    "pagination:snap": "node --import ./scripts/register.mjs scripts/dumpPagination.ts --snap",
    "oracle": "node --import ./scripts/register.mjs scripts/diffOracle.ts",
    "text": "node --import ./scripts/register.mjs scripts/dumpText.ts",
    "rows": "node --import ./scripts/register.mjs scripts/dumpRows.ts",
    "render": "node --import ./scripts/register.mjs scripts/renderFixture.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./spike": "./spike/spike.ts"
  },
  "dependencies": {
    "@mmsb/core": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
